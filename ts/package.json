{
  "name": "helpdesk-client",
  "version": "0.1.0",
  "private": true,
  "description": "A typed client and command-line tool for the helpdesk API.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc",
    "lint": "eslint .",
    "deps": "depcruise src scripts test --config .dependency-cruiser.cjs --output-type err-long",
    "test": "vitest run",
    "cli": "node src/cli.ts",
    "api-types": "node scripts/api-types.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@typescript/native": "npm:typescript@^7.0.2",
    "dependency-cruiser": "^18.4.0",
    "eslint": "^10.11.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.1"
  }
}
